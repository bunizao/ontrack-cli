{
  // The Okta sign-in, the OnTrack client and the shared service must run in Node, Bun
  // and Cloudflare Workers alike, so they are checked without Node's types: a node:
  // import, Buffer or process fails here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "noEmit": true
  },
  "include": ["src/okta-sign-in.ts", "src/okta-renewal.ts", "src/application-core.ts", "src/ontrack.ts", "src/token-exchange.ts"]
}
